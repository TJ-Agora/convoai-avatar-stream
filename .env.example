# --- Agora core (required) ---
AGORA_APP_ID=
NEXT_PUBLIC_AGORA_APP_ID=           # same App ID, exposed to the browser
AGORA_USERNAME=                     # REST API customer key
AGORA_PASSWORD=                     # REST API customer secret
AGORA_APP_CERTIFICATE=              # for token generation (enable token auth on the project)

# --- Anam avatar (required — the shipped flow uses Minimax TTS + Anam) ---
ANAM_API_KEY=
ANAM_AVATAR_ID=

# --- Lemonslice avatar (optional — create a stream from /?avatar=lemonslice) ---
# AVATAR_ID accepts an agent id (agent_…) OR a public https image URL; hosts can
# also override per stream via the setup form's AVATAR IMAGE URL field.
# Uses Agora's generic avatar interface (vendor: generic + Lemonslice's liveai endpoint).
LEMONSLICE_API_KEY=
LEMONSLICE_AVATAR_ID=

# --- Optional tuning (defaults shown) ---
AGORA_PRESET_ASR_LLM=deepgram_nova_3,openai_gpt_4o_mini
MINIMAX_VOICE_ID=English_captivating_female1
TTS_SPEED=1.0
AVATAR_AGORA_UID=102

# Other vendors (Microsoft TTS, OpenAI TTS preset, HeyGen avatars) exist in
# lib/agoraService.js but aren't exposed by the setup UI — see the README.

# --- Upstash Redis (channel state; from the Vercel Marketplace integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Agora SSO (hosts only; guests stay public) ---
# Local dev: bypass = synthetic user, no credentials needed.
# Production: set AUTH_MODE=sso + the three AGORA_SSO_* values (from the
# internal SSO credential request) — see CLAUDE.md "Auth" for the flip steps.
AUTH_MODE=bypass
AGORA_SSO_CLIENT_ID=
AGORA_SSO_CLIENT_SECRET=
AGORA_SSO_REDIRECT_URI=             # https://<domain>/api/auth/agora/callback
SESSION_JWT_SECRET=                 # openssl rand -hex 48
