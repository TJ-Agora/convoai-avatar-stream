# --- Agora core (required) ---
AGORA_APP_ID=
NEXT_PUBLIC_AGORA_APP_ID=           # same App ID, exposed to the browser
AGORA_USERNAME=                     # REST API customer key
AGORA_PASSWORD=                     # REST API customer secret
AGORA_APP_CERTIFICATE=              # for token generation (enable token auth on the project)

# --- Agent preset (ASR + LLM + TTS) ---
AGORA_PRESET=deepgram_nova_3,openai_gpt_4o_mini,minimax_speech_2_6_turbo
AGORA_PRESET_ASR_LLM=deepgram_nova_3,openai_gpt_4o_mini

# --- TTS ---
MINIMAX_VOICE_ID=English_captivating_female1
TTS_SPEED=1.0

# --- Avatar (recommended: Anam) ---
AVATAR_AGORA_UID=102
ANAM_API_KEY=
ANAM_AVATAR_ID=
# Optional alternative
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
